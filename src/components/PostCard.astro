---
import type { CollectionEntry } from 'astro:content';
import { asset, dateLabel, readingTime, url } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; index?: number; }
const { post, index = 0 } = Astro.props;
---
<article class:list={['post-card', `card-${index % 3}`]} data-tags={JSON.stringify(post.data.tags)}>
  <a class="card-image" href={url(`posts/${post.id}/`)} tabindex="-1" aria-hidden="true">
    <img src={asset(post.data.cover || 'art/fields.svg')} alt="" width="720" height="480" loading="lazy" />
    <span class="image-label">{post.data.tags[0]} / {String(index + 1).padStart(2, '0')}</span>
  </a>
  <div class="card-content">
    <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readingTime(post.body)} 分钟阅读</span></div>
    <h3><a href={url(`posts/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="card-bottom"><span class="tag"># {post.data.tags[0]}</span>{post.data.example && <span class="example-label">示例文章</span>}<a class="card-arrow" href={url(`posts/${post.id}/`)} aria-label={`阅读：${post.data.title}`}>↗</a></div>
  </div>
</article>
