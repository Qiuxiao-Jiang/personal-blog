---
import '../styles/global.css';
import '../styles/doodle.css';
import { profile } from '../config';
import { url, asset } from '../lib/posts';
interface Props { title?: string; description?: string; active?: string; image?: string; noindex?: boolean; }
const { title, description = profile.description, active = '', image, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.title}` : `${profile.title} · 生活嘛，乱涂乱画也行`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d4ff63" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={active === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {image && <meta property="og:image" content={new URL(asset(image), Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="brand" href={url()} aria-label={`${profile.title}，首页`}>
        <span class="brand-icon" aria-hidden="true"><svg viewBox="0 0 38 42" fill="none"><path d="M6 4h24l3 30-26 4L6 4Z" fill="#e2aa73"/><path d="m4 6 26-3 3 31-26 3L4 6Z" fill="#f9f7ee" stroke="currentColor" stroke-width="1.5"/><path d="m11 14 13-1m-12 7 12-1m-11 7 7-.6M9 3l1 6M16 2l1 6M23 1l1 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
        <span><strong>{profile.title}<span class="brand-dot">.</span></strong><small>A PERSONAL JOURNAL</small></span>
      </a>
      <nav aria-label="主导航">
        <a href={url()} aria-current={active === 'home' ? 'page' : undefined}>首页</a>
        <a href={url('posts/')} aria-current={active === 'posts' || active === 'article' ? 'page' : undefined}>所有文章</a>
        <a href={url('about/')} aria-current={active === 'about' ? 'page' : undefined}>关于我<span class="nav-flower" aria-hidden="true"> ✳</span></a>
      </nav>
      <span class="header-note">禁止无聊！ <span aria-hidden="true">↗</span></span>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href={url()}>{profile.title}<span> ✳</span></a><p>留住微小，也留住美好。</p></div>
      <div class="footer-right"><p>© {new Date().getFullYear()} {profile.name} · 用心记录，慢慢生长</p><a href={url('about/')}>很高兴，在这里遇见你 <span aria-hidden="true">↗</span></a></div>
    </footer>
  </body>
</html>
