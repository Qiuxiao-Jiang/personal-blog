---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { profile } from '../config';
import { asset, publishedPosts, url } from '../lib/posts';
const posts = await publishedPosts();
const featured = posts.find(post => post.data.featured) || posts[0];
---
<Base active="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-line"></span> {profile.subtitle}</div>
      <h1 id="hero-title">生活嘛，<span class="hero-little-star" aria-hidden="true">✷</span><br /><span class="underlined">乱涂乱画也行<svg viewBox="0 0 420 22" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12C80 21 130-3 203 9S333 18 416 5M24 20C132 11 249 19 398 14" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span><span class="orange-dot">！</span></h1>
      <p class="hero-description">你好，我是{profile.name}。<span class="hello-sun" aria-hidden="true">☼</span><br />偶尔在人间，偶尔不在线。<br />这里收留一些念头，和暂时没想明白的事。</p>
      <div class="hero-actions"><a class="button" href={url('posts/')}>看看我在想什么 <span aria-hidden="true">↗</span></a><span class="handwritten">没有标准答案，随便翻！</span></div>
      <div class="hero-footnote"><span class="status-dot"></span> 缓慢加载中 <span class="divider">/</span> 生活 · 阅读 · 在别处</div>
    </div>
    <div class="hero-collage" aria-label="田野、山野和手写便签组成的生活拼贴">
      <div class="collage-grid" aria-hidden="true"></div>
      <span class="doodle-star" aria-hidden="true">✳</span>
      <figure class="polaroid polaroid-back"><span class="tape tape-sage" aria-hidden="true"></span><img src={asset('art/mountains.svg')} alt="绿色山峦与蜿蜒溪流的插画" width="720" height="480" /><figcaption>somewhere, at my own pace.</figcaption></figure>
      <figure class="polaroid polaroid-front"><span class="tape" aria-hidden="true"></span><img src={asset('art/fields.svg')} alt="阳光下的田野、小屋与远山插画" width="720" height="480" /><figcaption>去有风的地方 <span>↗</span></figcaption></figure>
      <div class="memo"><span class="memo-pin" aria-hidden="true"></span><small>NOTE TO SELF</small><p>今天也没<br />想明白。<br /><span>先喝口水。</span></p><span class="memo-flower" aria-hidden="true">✿</span></div>
      <div class="round-stamp" aria-hidden="true"><span>100% ORIGINAL</span><strong>STAY<br />WEIRD!</strong><span>0% BORING</span></div>
      <span class="collage-caption handwritten">一些被好好收藏的瞬间 ↖</span>
    </div>
  </section>
  <div class="journal-ribbon"><div class="wrap"><span>✳ 不必合理，先有意思。 <span aria-hidden="true">↗</span></span><span class="ribbon-right">GOOD THOUGHTS. WEIRD THOUGHTS. ALL WELCOME. <span aria-hidden="true">✳</span></span></div></div>
  <section class="journal-section wrap" aria-labelledby="recent-heading">
    <div class="section-heading"><div><div class="eyebrow">THE LATEST PAGES</div><h2 id="recent-heading">最近，写下这些 <span class="heading-spark" aria-hidden="true">✧</span></h2></div><a class="text-link" href={url('posts/')}>全部文章 <span aria-hidden="true">↗</span></a></div>
    <div class="home-columns"><div class="post-grid">{posts.slice(0, 3).map((post, index) => <PostCard post={post} index={index} />)}</div><aside class="sidebar-note"><span class="tape tape-sage" aria-hidden="true"></span><span class="note-kicker">A LITTLE ABOUT ME</span><div class="avatar" aria-hidden="true">{profile.name.slice(0, 1)}<br />{profile.name.slice(1, 2)}<span>✿</span></div><h3>嗨，很高兴遇见你。</h3><p>{profile.introduction}</p><a class="text-link" href={url('about/')}>再多了解一点 <span aria-hidden="true">↗</span></a><div class="sidebar-dashed"></div><span class="note-kicker">当前精神状态</span><p class="current-joy">像一朵还没决定<br />要飘去哪里的云。</p>{profile.exampleProfile && <span class="example-label">示例个人资料 · 等你来改写</span>}</aside></div>
  </section>
  {featured && <section class="featured-section wrap"><div class="featured-heading"><span class="eyebrow">A PAGE TO KEEP</span><h2>夹在书里的<br />那一页。</h2><p>有些时刻，值得多停留一会儿。</p><span class="handwritten">我的精选 ↗</span></div><a class="featured-card" href={url(`posts/${featured.id}/`)}><img src={asset(featured.data.cover || 'art/fields.svg')} alt={featured.data.coverAlt} loading="lazy" width="720" height="480" /><div><span class="tag">精选手记 / {featured.data.tags[0]}</span><h3>{featured.data.title}</h3><p>{featured.data.description}</p><span class="text-link">读读这一篇 ↗</span></div></a></section>}
  <section class="closing-note wrap"><span aria-hidden="true">✳</span><p>今天先这样，明天再胡思乱想。</p><small>STAY CURIOUS. STAY A LITTLE WEIRD.</small></section>
</Base>
